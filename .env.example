# =============================================================================
#  Voice-Agent — Konfiguration
# =============================================================================
#  cp .env.example .env  und dann ausfüllen.
#  Die .env ist über .gitignore ausgeschlossen und gehört nie ins Repo.
#
#  Geheimnisse erzeugen:  openssl rand -hex 32
# =============================================================================


# -----------------------------------------------------------------------------
#  Grundlegendes
# -----------------------------------------------------------------------------

TZ=Europe/Berlin

# Damjans Handynummer in E.164. Zwei Aufgaben:
#   * Ziel beim Durchstellen
#   * Empfänger der WhatsApp-Meldungen
OWNER_PHONE=+49XXXXXXXXXX


# -----------------------------------------------------------------------------
#  Datenbank
# -----------------------------------------------------------------------------

DB_USER=voiceagent
DB_NAME=voiceagent
DB_PASSWORD=
# 5432 und 5433/5434 sind auf diesem Server belegt.
DB_PORT=5435


# -----------------------------------------------------------------------------
#  n8n
# -----------------------------------------------------------------------------
#  Eigene Instanz, getrennt von der auf Port 5678 (Hörakustik-Projekt).

N8N_VERSION=2.32.6
N8N_DOMAIN=voice.damjan-savic.com
N8N_BASE_URL=https://voice.damjan-savic.com
N8N_LOCAL_PORT=5679

# Vom Host aus, für die Skripte.
N8N_INTERN_URL=http://127.0.0.1:5679

# openssl rand -hex 32
# ACHTUNG: Wird dieser Schlüssel getauscht, sind alle in n8n hinterlegten
# Zugangsdaten unbrauchbar. Vor dem Ändern ein Backup, sonst muss der
# Google-Zugang neu eingerichtet werden.
N8N_ENCRYPTION_KEY=

# Anzulegen in n8n: Settings → n8n API → Create API key.
# Erst nach dem ersten Start verfügbar — beim Einrichten also zunächst leer
# lassen, hochfahren, Schlüssel holen, hier eintragen.
N8N_API_KEY=

N8N_LOG_LEVEL=info


# -----------------------------------------------------------------------------
#  Control-API
# -----------------------------------------------------------------------------

CONTROL_API_PORT=3010

# Der WhatsApp-Bot und das CLI weisen sich damit aus. openssl rand -hex 32
CONTROL_API_TOKEN=

# Vom Host aus (Bot, CLI).
CONTROL_API_URL=http://127.0.0.1:3010
# Aus dem Docker-Netz heraus (n8n).
CONTROL_API_INTERN_URL=http://control-api:3010


# -----------------------------------------------------------------------------
#  Webhooks
# -----------------------------------------------------------------------------

# Öffentliche Basis der Webhooks. Muss von außen per HTTPS erreichbar sein —
# ElevenLabs ruft hier an.
VOICE_WEBHOOK_BASE=https://voice.damjan-savic.com/webhook/voice

# Wird von den ElevenLabs-Werkzeugen als X-Voice-Token mitgeschickt und von
# der Control-API geprüft. openssl rand -hex 32
VOICE_WEBHOOK_TOKEN=


# -----------------------------------------------------------------------------
#  ElevenLabs
# -----------------------------------------------------------------------------

ELEVENLABS_API_KEY=

# Wird von scripts/provision-elevenlabs.mjs beim ersten Lauf ausgegeben.
ELEVENLABS_AGENT_ID=

# Das HMAC-Geheimnis des Post-Call-Webhooks. Wird beim ANLEGEN des Webhooks
# genau einmal ausgeliefert — sofort hier eintragen. Geht es verloren, hilft
# nur, den Webhook zu löschen und neu anzulegen.
ELEVENLABS_WEBHOOK_SECRET=

# Anführungszeichen nicht weglassen — der Wert enthält ein Leerzeichen, und
# Shell-Skripte, die die .env einlesen, stolpern sonst darüber.
AGENT_NAME="Vorzimmer Damjan Savić"

# Das Sprachmodell des Agents. Beide sind nativ unterstützt, kein Custom-LLM
# nötig. Vollständige Liste mit Preisen: elevenlabs/llm-preise.json
#
#   gemini-2.5-flash   ElevenLabs-Standard. Schnellste Antwort, ~0,0014 $/Min.
#   claude-haiku-4-5   Urteilt bei "durchstellen oder nicht" sorgfältiger,
#                      ~0,0098 $/Min, minimal träger.
#
# Empfehlung: mit gemini-2.5-flash anfangen. Wenn der Agent zu oft oder zu
# selten durchstellt, auf claude-haiku-4-5 wechseln — das ist der Unterschied,
# den man tatsächlich hört.
ELEVENLABS_LLM=gemini-2.5-flash

# Stimme. Vorgabe ist eine deutsche Stimme aus der öffentlichen Bibliothek.
#   lvkL7QrPZkQjagcXVZ5M  Daniel — ruhig, sachlich  (Vorgabe)
#   WZPpF1AG5FuLRSOxuLpC  Jens — ruhig
#   ZD3ZSPgXfFSWm3piBipz  Linda — freundlich, klar
#   ubFP6jET0T3oGNth3wzQ  Damjans eigener Voice-Clone
#
# Zum Clone: Er ist da und funktioniert. Bedenke aber, dass ein Anrufer die
# eigene Stimme auf der eigenen Nummer hört — der Agent sagt zwar, dass er
# eine KI ist, aber die ersten Sekunden klingen nach dir. Eine fremde Stimme
# beantwortet die Frage, bevor sie aufkommt.
ELEVENLABS_VOICE_ID=lvkL7QrPZkQjagcXVZ5M

# Wie durchgestellt wird:
#   conference  Vorgabe. Geht mit Twilio UND SIP-Trunk. Auf dem Display
#               erscheint die Agent-Nummer — man sieht sofort, dass der
#               Agent durchstellt.
#   blind       Zeigt die Nummer des echten Anrufers, geht aber NUR mit der
#               nativen Twilio-Anbindung.
#   sip_refer   Für SIP-Trunks ohne Konferenzbrücke.
TRANSFER_TYPE=conference


# -----------------------------------------------------------------------------
#  Anthropic
# -----------------------------------------------------------------------------
#  Nur für die Nachbereitung: fasst Gespräche zusammen, bei denen der Agent
#  nicht mehr zum Notieren kam. Der Schlüssel wird als Header-Auth-Credential
#  in n8n hinterlegt (Name: x-api-key), nicht von hier gelesen.

ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
#  Google Kalender
# -----------------------------------------------------------------------------
#  Die Zugangsdaten selbst liegen in n8n, nicht hier. Hier steht nur, WELCHE
#  Kalender gelesen werden. Einrichtung: docs/03-einrichtung.md
#
#  Wichtig: NICHT "primary" eintragen. Bei einem Dienstkonto zeigt "primary"
#  auf dessen eigenen, leeren Kalender — die Abfrage liefert dann fröhlich
#  "alles frei" und der Agent bucht mitten in bestehende Termine.

# Kalender, in den Termine eingetragen werden.
GOOGLE_KALENDER_PRIMAER=info@damjan-savic.com

# Alle Kalender, die für "belegt" zählen. Kommagetrennt. Hier gehören auch
# der Arbeitskalender und geteilte Kalender hinein.
GOOGLE_KALENDER_IDS=info@damjan-savic.com

# Wie viel Vorlauf ein vorgeschlagener Termin mindestens hat.
TERMIN_VORLAUF_STUNDEN=3


# -----------------------------------------------------------------------------
#  Telefonie
# -----------------------------------------------------------------------------
#  Details und die Wahl des Anbieters: docs/02-telefonie.md
#
#  Kurz: Die eigene Mobilnummer kann NICHT zu einem VoIP-Anbieter portiert
#  werden (deutsche Mobilnummern sind von der Portierung ausgeschlossen).
#  Der Agent bekommt deshalb eine Zweitnummer, auf die das Handy bedingt
#  umleitet. Für den Anrufer sieht es aus, als ginge der Agent auf der
#  eigenen Nummer ran.

# Die Nummer, auf die umgeleitet wird.
AGENT_PHONE_NUMBER=

# Wird von scripts/telefonnummer.mjs gesetzt.
PHONE_NUMBER_ID=

# twilio | sip_trunk
TELEFON_ANBIETER=sip_trunk

# --- nur bei TELEFON_ANBIETER=twilio ---
# Twilio verkauft in Deutschland KEINE Nummern an Privatpersonen. Es braucht
# eine Gewerbeanmeldung oder einen Handelsregisterauszug, und die Adresse muss
# zum Vorwahlgebiet passen.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Ohne region_config routet Twilio auch deutsche Nummern über die USA —
# das verletzt die Datenresidenz UND lässt Transfers scheitern.
TWILIO_REGION_ID=ie1
TWILIO_EDGE=frankfurt

# --- nur bei TELEFON_ANBIETER=sip_trunk ---
# Empfohlen für Deutschland: sipgate trunking. Deutscher Anbieter, deutsche
# Rechnung, Freischaltung binnen Stunden, 30 Tage Test.
# Beim Anbieter als Origination-URI eintragen:
#     sip:sip.rtc.elevenlabs.io:5060;transport=tcp
SIP_BENUTZER=
SIP_PASSWORT=
# Reiner Hostname, OHNE "sip:" davor.
SIP_ADRESSE=sipgate.de
SIP_TRANSPORT=tls
