#!/usr/bin/env node
// =============================================================================
//  voiceagent — Steuerung von der Kommandozeile
// =============================================================================
//  Dieselben Möglichkeiten wie über WhatsApp, nur per SSH. Nützlich, wenn
//  WhatsApp gerade das Problem ist.
//
//  Einrichten:
//    chmod +x cli/voiceagent
//    sudo ln -sf ~/voice-agent/cli/voiceagent /usr/local/bin/voiceagent
//
//  Beispiele:
//    voiceagent                          Zustand
//    voiceagent aus bis 16 uhr
//    voiceagent notiz --hinweis "im Workshop"
//    voiceagent anrufe 10
//    voiceagent flows
// =============================================================================

import { readFile } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const WURZEL = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');

const farbe = process.stdout.isTTY;
const c = (code, s) => (farbe ? `[${code}m${s}[0m` : s);

async function env() {
  const datei = path.join(WURZEL, '.env');
  if (!existsSync(datei)) {
    console.error(c(31, `.env fehlt unter ${WURZEL}`));
    process.exit(1);
  }
  const e = {};
  for (const zeile of (await readFile(datei, 'utf8')).split('\n')) {
    const t = zeile.match(/^\s*([A-Z_][A-Z0-9_]*)\s*=\s*(.*)$/);
    if (!t) continue;
    let v = t[2].trim();
    if (/^".*"$/.test(v) || /^'.*'$/.test(v)) v = v.slice(1, -1);
    e[t[1]] = v;
  }
  return { ...e, ...process.env };
}

/** WhatsApp-Auszeichnung in Terminal-Auszeichnung übersetzen. */
function fuersTerminal(text) {
  if (!farbe) return text.replace(/\*(.+?)\*/g, '$1').replace(/_(.+?)_/g, '$1');
  return String(text)
    .replace(/\*(.+?)\*/g, (_, s) => c(1, s))
    .replace(/_(.+?)_/g, (_, s) => c(3, s))
    .replace(/`(.+?)`/g, (_, s) => c(36, s));
}

async function ruf(e, pfad, { method = 'GET', body } = {}) {
  const basis = e.CONTROL_API_URL || `http://127.0.0.1:${e.CONTROL_API_PORT || 3010}`;
  try {
    const antwort = await fetch(`${basis}${pfad}`, {
      method,
      signal: AbortSignal.timeout(25_000),
      headers: {
        Authorization: `Bearer ${e.CONTROL_API_TOKEN ?? ''}`,
        'X-Akteur': `cli:${process.env.USER ?? 'unbekannt'}`,
        ...(body ? { 'Content-Type': 'application/json' } : {}),
      },
      body: body ? JSON.stringify(body) : undefined,
    });
    const daten = await antwort.json().catch(() => ({}));
    if (!antwort.ok) {
      console.error(fuersTerminal(daten.text || daten.fehler || `HTTP ${antwort.status}`));
      process.exit(1);
    }
    return daten;
  } catch (err) {
    console.error(c(31, `Control-API nicht erreichbar: ${err.message}`));
    console.error(c(90, `  ${basis} — läuft der Container? "make status"`));
    process.exit(1);
  }
}

const HILFE = `
${c(1, 'voiceagent')} — Telefon-Vorzimmer steuern

  ${c(1, 'voiceagent')}                        Zustand anzeigen
  ${c(1, 'voiceagent an|notiz|aus')}           Modus umstellen
  ${c(1, 'voiceagent aus bis 16 uhr')}         Befristet
  ${c(1, 'voiceagent notiz 2h')}               Für zwei Stunden
  ${c(1, 'voiceagent aus --hinweis "..."')}    Mit Ansage für den Anrufer

  ${c(1, 'voiceagent anrufe [n]')}             Letzte Anrufe
  ${c(1, 'voiceagent nachrichten [alle]')}     Nachrichten
  ${c(1, 'voiceagent erledigt <nr>')}          Nachricht abhaken
  ${c(1, 'voiceagent termine')}                Vereinbarte Termine
  ${c(1, 'voiceagent flows')}                  n8n-Workflows
  ${c(1, 'voiceagent flows an|aus <slug>')}    Workflow schalten
  ${c(1, 'voiceagent kontakte')}               Hinterlegte Anrufer
  ${c(1, 'voiceagent json <pfad>')}            Rohdaten, z.B. json /v1/status
`;

async function main() {
  const argv = process.argv.slice(2);
  const e = await env();

  const hinweisIndex = argv.findIndex((a) => a === '--hinweis');
  let hinweis;
  if (hinweisIndex >= 0) {
    hinweis = argv[hinweisIndex + 1];
    argv.splice(hinweisIndex, 2);
  }

  const [befehl = '', ...rest] = argv;

  if (/^(-h|--help|hilfe|help)$/.test(befehl)) { console.log(HILFE); return; }

  // Ohne Argumente: Zustand.
  if (!befehl) {
    const d = await ruf(e, '/v1/status');
    console.log('\n' + fuersTerminal(d.text) + '\n');
    return;
  }

  // Ein Modus als erstes Wort ist die häufigste Eingabe — die soll ohne
  // Unterbefehl funktionieren.
  if (/^(an|ein|aktiv|notiz|nur-notiz|stumm|aus|off|urlaub|meeting)$/i.test(befehl)) {
    const bis = rest[0]?.toLowerCase() === 'bis' ? rest.slice(1).join(' ') : rest.join(' ');
    const d = await ruf(e, '/v1/modus', {
      method: 'POST',
      body: { modus: befehl, bis: bis || undefined, hinweis },
    });
    console.log('\n' + fuersTerminal(d.text) + '\n');
    return;
  }

  switch (befehl) {
    case 'status':
      console.log('\n' + fuersTerminal((await ruf(e, '/v1/status')).text) + '\n');
      break;

    case 'anrufe': {
      const n = Math.min(Math.max(parseInt(rest[0], 10) || 10, 1), 50);
      console.log('\n' + fuersTerminal((await ruf(e, `/v1/anrufe?limit=${n}`)).text) + '\n');
      break;
    }

    case 'nachrichten': {
      const alle = /^(alle|all)$/i.test(rest[0] ?? '');
      console.log('\n' + fuersTerminal((await ruf(e, `/v1/nachrichten?offen=${alle ? 0 : 1}`)).text) + '\n');
      break;
    }

    case 'erledigt': {
      const id = parseInt(rest[0], 10);
      if (!Number.isFinite(id)) { console.error('Nummer fehlt: voiceagent erledigt 12'); process.exit(1); }
      console.log(fuersTerminal((await ruf(e, `/v1/nachrichten/${id}/erledigt`, { method: 'POST' })).text));
      break;
    }

    case 'termine':
      console.log('\n' + fuersTerminal((await ruf(e, '/v1/termine')).text) + '\n');
      break;

    case 'kontakte':
      console.log('\n' + fuersTerminal((await ruf(e, '/v1/kontakte')).text) + '\n');
      break;

    case 'flows':
    case 'workflows': {
      if (!rest.length) {
        console.log('\n' + fuersTerminal((await ruf(e, '/v1/workflows')).text) + '\n');
        break;
      }
      const aktion = /^(an|ein|start)$/i.test(rest[0]) ? 'aktivieren'
        : /^(aus|stop)$/i.test(rest[0]) ? 'deaktivieren' : null;
      if (!aktion || !rest[1]) {
        console.error('Aufruf: voiceagent flows an|aus <slug>');
        process.exit(1);
      }
      const d = await ruf(e, `/v1/workflows/${encodeURIComponent(rest[1])}/${aktion}`, { method: 'POST' });
      console.log(fuersTerminal(d.text));
      break;
    }

    case 'json': {
      const pfad = rest[0] || '/v1/status';
      console.log(JSON.stringify(await ruf(e, pfad), null, 2));
      break;
    }

    default:
      console.error(`Unbekannt: ${befehl}`);
      console.log(HILFE);
      process.exit(1);
  }
}

main().catch((err) => { console.error(c(31, err.stack ?? err.message)); process.exit(1); });
